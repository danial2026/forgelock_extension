{
  "manifest_version": 2,
  "name": "ForgeLock",
  "version": "0.1.0",
  "description": "Secure password generator",
  "icons": {
    "128": "icons/128.png",
    "512": "icons/512.png",
    "16": "icons/favicon.png"
  },
  "permissions": ["clipboardWrite", "https://forgelock.danials.space/"],
  "browser_action": {
    "default_icon": {
      "16": "icons/favicon.png",
      "128": "icons/128.png"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "forgelock@danials.space",
      "strict_min_version": "57.0"
    }
  }
}
